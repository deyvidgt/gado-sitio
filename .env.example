# Variáveis de ambiente para Sítio Santo Antonio
# Copie este arquivo para .env e preencha os valores reais
# NUNCA commitar .env com valores reais no Git!

# CRÍTICO: Chave secreta da sessão
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
GADO_SECRET_KEY=seu_token_secreto_seguro_aqui_minimo_32_caracteres

# Pasta de dados (padrão: ~/gado-dados/)
GADO_DATA_DIR=

# Flask environment
FLASK_ENV=production

# Modo debug (NUNCA True em produção!)
FLASK_DEBUG=False

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Session security
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=28800

# Rate limiting
RATELIMIT_ENABLED=True
RATELIMIT_LOGIN_ATTEMPTS=5
RATELIMIT_LOGIN_PERIOD=300

# HTTPS/HTTPS redirect
PREFERRED_URL_SCHEME=https
